#!/usr/bin/env bash
set -e

usage() {
    cat <<EOF
Usage:
  bbctl init LXC_NAME
  bbctl phase1 LXC_NAME
  bbctl phase3 LXC_NAME
  bbctl setup LXC_NAME [COMMAND [ARGS...]]
  bbctl admin LXC_NAME [COMMAND [ARGS...]]
  bbctl hub LXC_NAME [ARGS...]
  bbctl upgrade LXC_NAME
  bbctl help
EOF
}

case ${1:-} in
    help|'') usage; exit 0 ;;
    init|phase1|phase3|setup|admin|hub|upgrade) ;;
    *) usage >&2; exit 1 ;;
esac
[[ $# -ge 2 ]] || { usage >&2; exit 1; }
bbsetup_url="https://raw.githubusercontent.com/BitBurrow/BitBurrow/main/hub_installer/bbsetup"
command=$1
lxc_name=$2
shift 2

case $command in
    init)
        [[ $# -eq 0 ]] || { usage >&2; exit 1; }
        lxc launch ubuntu: "$lxc_name"
        ;;
    phase1)
        [[ $# -eq 0 ]] || { usage >&2; exit 1; }
        lxc exec "$lxc_name" -- sudo --user ubuntu -i wget --output-document=bbsetup $bbsetup_url
        lxc exec "$lxc_name" -- sudo --user ubuntu -i sudo bash bbsetup phase1
        ;;
    phase3)
        [[ $# -eq 0 ]] || { usage >&2; exit 1; }
        lxc exec "$lxc_name" -- sudo --user ubuntu -i sudo bash bbsetup phase3
        lxc exec "$lxc_name" -- sudo --user bitburrow -i /home/bitburrow/bitburrow/.venv/bin/bbhub test all
        ;;
    setup)
        lxc exec "$lxc_name" -- sudo --user ubuntu -i "$@"
        ;;
    admin)
        lxc exec "$lxc_name" -- sudo --user bitburrow -i "$@"
        ;;
    hub)
        lxc exec "$lxc_name" -- sudo --user bitburrow -i /home/bitburrow/bitburrow/.venv/bin/bbhub "$@"
        ;;
    upgrade)
        [[ $# -eq 0 ]] || { usage >&2; exit 1; }
        lxc exec "$lxc_name" -- sudo --user ubuntu -i wget --output-document=bbsetup $bbsetup_url
        lxc exec "$lxc_name" -- sudo --user ubuntu -i sudo bash bbsetup phase3
        ;;
esac
