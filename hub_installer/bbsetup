#!/bin/bash
# cSpell:disable  # don't spell check this file
set -e
[[ $# -eq 1 && ( $1 == phase1 || $1 == phase3 ) ]] || exit 1
# phase1 → install hub, generate a config file template
# phase2 → edit config.yaml, run port-forward-script (not this file)
# phase3 → do phase1, systemd service, BIND, Certbot"

## verify $SUDO_USER
test "x$SUDO_USER" != "x" || (echo "Run this script as a normal user using 'sudo'."; false)
test "x$SUDO_USER" != "xroot" || (echo "Run this script as a normal user using 'sudo'."; false)
SUDO_USER_HOME=$(eval echo "~$SUDO_USER")

## install dependencies
if ! command -v wget >/dev/null || ! command -v ansible-playbook >/dev/null; then
  sudo apt update
  sudo apt install -y wget ansible
fi

## create Ansible script that does most of the installing
mkdir -p "$SUDO_USER_HOME/hub/"
cat <<"_EOF3703_" >"$SUDO_USER_HOME/hub/install.yaml"
---
- hosts: localhost
  connection: local  # don't use Ansible over ssh
  gather_facts: false  # save time; not needed for these tasks
  become: true
  tasks:

  - name: Run apt upgrade
    apt:
      upgrade: "yes"  # quotes avoid https://github.com/ansible/ansible/issues/56788
      update_cache: true
      cache_valid_time: 432000  # ≥5 days

  - name: Install package dependencies
    # debugging: df --si /  # check in container *and* on host
    apt:
      name:
      - unattended-upgrades
      - python3-poetry  # to install BitBurrow
      - wireguard-tools
      - sqlite3
      - bind9-dnsutils  # `dig` tool
      - tcpdump  # capture packets to replay on base router
      # 'acl' avoids Ansible temp file permissions issue in 'Install bbhub 🦶1--git clone'
      # (note that creating /home/bitburrow/.ansible/tmp doesn't help; we need package 'acl')
      - acl
      state: latest

  - name: Define poetry path
    set_fact:
      poetry: /usr/bin/poetry
    changed_when: false

  - name: Enable automatic security updates
    # requires package unattended-upgrades
    # see also https://help.ubuntu.com/community/AutomaticSecurityUpdates
    copy:
      content: |
        APT::Periodic::Update-Package-Lists "1";
        APT::Periodic::Unattended-Upgrade "1";
        APT::Periodic::Download-Upgradeable-Packages "1";
        APT::Periodic::AutocleanInterval "7";
      dest: /etc/apt/apt.conf.d/20auto-upgrades
      mode: '0644'

  - name: Allow sudo without password for specific commands
    copy:
      content: |
        bitburrow  ALL = NOPASSWD: /bin/wg *
        bitburrow  ALL = NOPASSWD: /sbin/wg *
        bitburrow  ALL = NOPASSWD: /usr/bin/wg *
        bitburrow  ALL = NOPASSWD: /usr/sbin/wg *
        bitburrow  ALL = NOPASSWD: /bin/ip *
        bitburrow  ALL = NOPASSWD: /sbin/ip *
        bitburrow  ALL = NOPASSWD: /usr/bin/ip *
        bitburrow  ALL = NOPASSWD: /usr/sbin/ip *
        bitburrow  ALL = NOPASSWD: /bin/sysctl *
        bitburrow  ALL = NOPASSWD: /sbin/sysctl *
        bitburrow  ALL = NOPASSWD: /usr/bin/sysctl *
        bitburrow  ALL = NOPASSWD: /usr/sbin/sysctl *
        bitburrow  ALL = NOPASSWD: /bin/iptables *
        bitburrow  ALL = NOPASSWD: /sbin/iptables *
        bitburrow  ALL = NOPASSWD: /usr/bin/iptables *
        bitburrow  ALL = NOPASSWD: /usr/sbin/iptables *
        bitburrow  ALL = NOPASSWD: /bin/tcpdump *
        bitburrow  ALL = NOPASSWD: /sbin/tcpdump *
        bitburrow  ALL = NOPASSWD: /usr/bin/tcpdump *
        bitburrow  ALL = NOPASSWD: /usr/sbin/tcpdump *
      dest: /etc/sudoers.d/bitburrow
      mode: '0640'

  - name: Add BitBurrow hub user
    user:
      name: bitburrow
      password: '!'  # disabled
      state: present
      create_home: true
      shell: /bin/bash

  - name: Install bbhub 🦶1--git clone
    git:
      repo: https://github.com/BitBurrow/BitBurrow.git
      dest: /home/bitburrow/bitburrow/
      version: main
      update: true
      depth: 1
    become_user: bitburrow
    register: git_result
    failed_when: >
      git_result is failed and
      'Local modifications exist' not in (git_result.msg | default(''))

  - name: Install bbhub 🦶2--configure Poetry so we can find .../bin/bbhub
    command:
      cmd: "{{ poetry }} config virtualenvs.in-project true"
    become_user: bitburrow
    changed_when: false
    when: git_result.changed

  - name: Install bbhub 🦶3--install
    shell: |-
      cd /home/bitburrow/bitburrow/
      {{ poetry }} install
    become_user: bitburrow
    when: git_result.changed

  - name: Install bbhub 🦶4--install headless Chromium for Robot Framework Browser
    shell: |-
      cd /home/bitburrow/bitburrow/
      {{ poetry }} run rfbrowser install chromium-headless-shell  # harmless to rerun
    become_user: bitburrow
    register: rfbrowser_install_binaries
    changed_when: "'Downloading ' in (rfbrowser_install_binaries.stdout | default(''))"

  - name: Install bbhub 🦶5--get Robot Framework dependencies list
    shell: |-
      cd /home/bitburrow/bitburrow/
      {{ poetry }} run rfbrowser install --dry-run --with-deps chromium-headless-shell
    become_user: bitburrow
    register: rfbrowser_dryrun
    changed_when: false
    failed_when: >-
      rfbrowser_dryrun.rc not in [0, 1] or
      (rfbrowser_dryrun.rc == 1 and 'Missing system dependencies (' not in rfbrowser_dryrun.stdout) or
      'Cannot install dependencies' in rfbrowser_dryrun.stdout

  - name: Install bbhub 🦶6--extract RF dependencies list from output
    set_fact:
      rfbrowser_missing_deps: >-
        {{
          rfbrowser_dryrun.stdout
            | regex_findall('^[ \t]+([a-z0-9][a-z0-9+.:-]*)\r?$', multiline=True)
        }}

  - name: Install bbhub 🦶7--check that the RF dependencies output was recognized
    assert:
      that:
        - >-
          rfbrowser_missing_deps | length > 0 or
          'All system dependencies are installed.' in rfbrowser_dryrun.stdout
      fail_msg: |
        Could not recognize the RF dependencies in dry-run output.
        ******* stdout: \n{{ rfbrowser_dryrun.stdout }}
        ******* stderr: \n{{ rfbrowser_dryrun.stderr }}
  
  - name: Install bbhub 🦶8--install Robot Framework dependencies
    apt:
      name: "{{ rfbrowser_missing_deps }}"
      state: present
      install_recommends: false
    when: rfbrowser_missing_deps | length > 0

  - name: Define bbhub path
    set_fact:
      bbhub: /home/bitburrow/bitburrow/.venv/bin/bbhub
    changed_when: false

  - name: Create config file template
    command:
      cmd: "{{ bbhub }} generate-config"
      creates: /home/bitburrow/.config/bitburrow/config.yaml
    become_user: bitburrow

  - name: Retrieve values from config.yaml
    command:
      argv: ["{{ bbhub }}", get-conf, "frontend.{{ item }}"]
    loop: [domain, ips]
    register: frontend_config
    changed_when: false
    become_user: bitburrow
    when: phase != 'phase1'

  - name: Set variables retrieved above
    set_fact:
      domain: "{{ frontend_config.results[0].stdout }}"
      ip: "{{ frontend_config.results[1].stdout }}"
    when: phase != 'phase1'

  - name: Create systemd service file
    copy:
      content: |
        [Unit]
        Description=BitBurrow
        Documentation=https://bitburrow.com
        After=network.target network-online.target
        #
        [Service]
        Type=exec
        RestartSec=2s
        User=bitburrow
        Group=bitburrow
        WorkingDirectory=/home/bitburrow/bitburrow
        ExecStart={{ poetry }} run python3 {{ bbhub }} serve
        Restart=always
        PrivateTmp=true
        # use a shared runtime directory so 'bbhub rce ...' can share FIFOs with by daemon
        RuntimeDirectory=bitburrow
        RuntimeDirectoryMode=0700
        RuntimeDirectoryPreserve=restart
        PrivateDevices=false
        NoNewPrivileges=false
        #
        [Install]
        WantedBy=multi-user.target
      dest: /etc/systemd/system/bitburrow.service
      mode: '0660'
    when: phase != 'phase1'

  - name: Enable systemd service file
    # debugging: sudo systemctl status bitburrow
    # debugging: sudo journalctl -u bitburrow
    systemd:
      name: bitburrow
      enabled: yes
      state: started
      masked: false
    when: phase != 'phase1'

  - name: Install BIND 🦶1--install
    apt:
      name:
      - bind9
      state: latest
    when: phase != 'phase1'

  - name: Install BIND 🦶2--options file
    # changes from default BIND named.conf.options file:
    # * remove comments, blank lines
    # * disable recursive resolver--add line: recursion no;
    # * disable version, hostname, etc. (`dig @[server ip] hostname.bind TXT CHAOS`)
    copy:
      content: |
        options {
            directory "/var/cache/bind";
            dnssec-validation auto;
            listen-on-v6 { any; };
            recursion no;
            version none;
            hostname none;
            server-id none;
        };
      dest: /etc/bind/named.conf.options
    register: bind_options
    when: phase != 'phase1'

  - name: Install BIND 🦶3--add zone config
    blockinfile:
      block: |
        zone "{{ domain }}" {
          type master;
          file "/var/cache/bind/db.{{ domain }}";
          allow-transfer { none; };
          update-policy local;
        };
      path: /etc/bind/named.conf.local
    register: bind_zone_config
    when: phase != 'phase1'

  - name: Install BIND 🦶4--add zone file
    # re CAA record, see https://letsencrypt.org/docs/caa/
    # FIXME: support ACME-CAA - https://www.devever.net/~hl/acme-caa-live and https://news.ycombinator.com/item?id=34035148
    copy:
      content: |
        ;
        ; BIND data file for {{ domain }}
        ;
        $TTL  500
        @ IN  SOA  {{ domain }}. root.localhost. (
                    5    ; Serial
               604800    ; Refresh
                86400    ; Retry
              2419200    ; Expire
                  500 )  ; Negative Cache TTL
        ;
        @ IN  NS   {{ domain }}.
        @ IN  A    {{ ip }}
        @ IN  CAA  0 issue "letsencrypt.org"
      dest: /var/cache/bind/db.{{ domain }}
      force: false  # do not overwrite if file exists (BIND rewrites this file)
      mode: '0644'
      owner: bind
      group: bind
    register: bind_zone_file
    when: phase != 'phase1'

  - name: Install BIND 🦶5--restart
    # debugging: sudo named-checkconf  # should display nothing
    # debugging: printf "zone vxm.example.org\nupdate delete testa.vxm.example.org.\nupdate add testa.vxm.example.org. 600 IN A 9.9.9.9\nsend\n" |sudo -u bind /usr/bin/nsupdate -l  # substitute your domain; see that no errors are displayed
    # debugging: dig @127.0.0.1 testa.vxm.example.org +short  # again, substitute your domain
    systemd:
      name: bind9
      enabled: yes
      state: restarted
    when: (phase != 'phase1') and (bind_options.changed or bind_zone_config.changed or bind_zone_file.changed)

  - name: Wildcard TLS cert 🦶1--create temp file
    tempfile:
      state: file
      suffix: .sh
    register: certbot_tmp
    changed_when: false  # just a temp file
    when: phase != 'phase1'

  - name: Wildcard TLS cert 🦶2--build certbot script
    command:
      cmd: "{{ bbhub }} tls-cert-script"
    become_user: bitburrow
    register: certbot_script
    changed_when: false
    when: phase != 'phase1'

  - name: Wildcard TLS cert 🦶3--write temp file
    copy:
      dest: "{{ certbot_tmp.path }}"
      content: "{{ certbot_script.stdout }}"
      mode: "0700"
    changed_when: false
    when: phase != 'phase1'

  - name: Wildcard TLS cert 🦶4--run script
    shell: |-
      set -e
      certbot_setup_script=/root/.cache/bitburrow/certbot-setup.done.sh
      if cmp -s {{ certbot_tmp.path }} "$certbot_setup_script"; then
        exit 0
      fi
      {{ certbot_tmp.path }}
      install -D --mode 0600 {{ certbot_tmp.path }} "$certbot_setup_script"
      echo BBSETUP_TLS_CHANGED
    register: certbot_run
    changed_when: "'BBSETUP_TLS_CHANGED' in certbot_run.stdout_lines"
    when: phase != 'phase1'

  - name: Wildcard TLS cert 🦶5--clean up
    file:
      path: "{{ certbot_tmp.path }}"
      state: absent
    changed_when: false
    when: phase != 'phase1'
_EOF3703_

## run Ansible script locally
cat <<"_EOF6471_" |sudo --user $SUDO_USER bash -s -- "$1"
mkdir -p ~/hub/ && cd $_
ansible-playbook -i localhost, install.yaml --extra-vars "phase=$1"
_EOF6471_
