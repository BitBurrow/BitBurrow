#!/usr/bin/env bash

###
### fail on error
###

set -eo pipefail

###
### make sure we are in the git root directory
###

pushd $(git rev-parse --show-toplevel) >/dev/null

###
### check dependencies
###

if ! command -v yq >/dev/null 2>&1; then
    echo "Missing dependency: this hook requires Kislyuk yq." >&2
    echo "Install Ubuntu's package with: sudo apt install yq" >&2
    exit 1
fi
yq_help="$(LC_ALL=C yq --help 2>&1 || true)"
if ! grep -Fq 'jq wrapper for YAML documents' <<< "$yq_help"; then
    echo "Unsupported yq: this hook requires Kislyuk yq (the jq wrapper)." >&2
    echo "Install Ubuntu's package with: sudo apt install yq" >&2
    exit 1
fi
if ! command -v jq >/dev/null 2>&1; then
    echo "Missing dependency: Kislyuk yq requires jq." >&2
    echo "Install Ubuntu's package with: sudo apt install jq" >&2
    exit 1
fi

###
### enforce formatting with Black
###

if ! poetry run black --check --quiet --line-length 100 --skip-string-normalization .; then
  # run again to display error message(s)
  poetry run black --check --line-length 100 --skip-string-normalization .
fi

###
### make sure there are no duplicate Berror codes (Bxxxxx codes to help ID points in the code)
###

# $TO_SCAN is: source-code files in repo plus staged; remove duplicates; remove non-existant files
TO_SCAN=$((git ls-files  '*.py' '*.dart'; git diff --name-only --cached) |sort |uniq |while read -r FILE; do [ -f "$FILE" ] && echo "$FILE"; done)
export DUP_BERROR_CODES=$(echo $TO_SCAN |tr ' ' '\n' |while read -r F; do if [ ! -L "$F" ]; then grep -o --no-filename 'B[0-9][0-9][0-9][0-9][0-9] ' "$F"; fi; done |sort |uniq --repeated)
if [ -n "$DUP_BERROR_CODES" ]; then echo "Please remove duplicate Berror code(s): $DUP_BERROR_CODES" |tr -d '\n'; echo; sleep 2; exit 1; fi

###
### update 'versions.yaml' to track timestamp of certain files and directories
###

versions_path='versions.yaml'
versions_changed=0
watch_list=(
    'hub/bbbased.lua'
    'hub/adopt5p.sh'
    'hub/'  # any file within; must end in a slash
)
[ -e "$versions_path" ] || printf 'paths: []\n' > "$versions_path"
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
# for b36datetime (Unix date in base 36), see also hub/net.py
b36datetime="$(date '+%s' |perl -lne '$a="0123456789abcdefghijklmnopqrstuvwxyz";$s="";do{$s=substr($a,$_%36,1).$s;$_=int($_/36)}while$_;printf"%07s\n",$s')"
for watched_path in "${watch_list[@]}"; do
    if [[ "$watched_path" == */ ]]; then
        matched=0
        while IFS= read -r staged_file; do
            if [[ "$staged_file" == "$watched_path"* ]]; then
                matched=1
                break
            fi
        done <<< "$staged_files"
        if [ "$matched" -ne 1 ]; then
            continue
        fi
    else
        if ! printf '%s\n' "$staged_files" |grep -Fxq -- "$watched_path"; then
            continue
        fi
    fi
    tmp_versions="$(mktemp)"
    if ! yq --yaml-output \
        --arg path "$watched_path" \
        --arg version "$b36datetime" \
        '.paths = ((.paths // []) | map(select(.path != $path))
            + [{"path": $path, "version": $version}])' \
        "$versions_path" > "$tmp_versions"; then
        rm -f "$tmp_versions"
        echo "Unable to update $versions_path; expected a top-level 'paths' list." >&2
        exit 1
    fi
    if ! cmp -s "$versions_path" "$tmp_versions"; then
        mv "$tmp_versions" "$versions_path"
        versions_changed=1
    else
        rm -f "$tmp_versions"
    fi
done
if [ "$versions_changed" -eq 1 ]; then
    git add "$versions_path"
fi

###
### update commit_date in 'hub/bbbased.lua'
###

bbbased_path='hub/bbbased.lua'
if printf '%s\n' "$staged_files" |grep -Fxq -- "$bbbased_path"; then
    sed -i "s|^\(local commit_date[[:space:]]*=[[:space:]]*\)'[^']*'|\1'$b36datetime'|" "$bbbased_path"
    git add "$bbbased_path"
fi

###
### return to former directory
###

popd >/dev/null

