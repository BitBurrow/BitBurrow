#!/usr/bin/env python3

import collections
from datetime import datetime as DateTime, timedelta as TimeDelta, timezone as TimeZone
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import yaml  # sudo apt install python3-yaml


def b36datetime() -> str:
    """Return time as a 7-character value (1-second resolution); see also hub/net.py

    Bash version: date '+%s' |perl -lne '$a="0123456789abcdefghijklmnopqrstuvwxyz";$s="";do{$s=substr($a,$_%36,1).$s;$_=int($_/36)}while$_;printf"%07s\n",$s'"""
    digits = '0123456789abcdefghijklmnopqrstuvwxyz'
    now = int(DateTime.now(TimeZone.utc).timestamp())
    result = ''
    while now:
        result = digits[now % 36] + result
        now //= 36
    return result.rjust(7, '0')


def git_files(*args: str) -> set[str]:
    """Return filenames from a Git command whose arguments include -z."""
    result = subprocess.run(['git', *args], check=True, stdout=subprocess.PIPE)
    # NUL separators preserve filenames containing spaces or newlines.
    return {os.fsdecode(name) for name in result.stdout.split(b'\0') if name}


def replace_file(path: Path, content: bytes) -> None:
    """Replace a file atomically while preserving its permissions."""
    temporary = tempfile.NamedTemporaryFile(dir=path.parent, prefix=f'.{path.name}.', delete=False)
    temporary_path = Path(temporary.name)
    try:
        with temporary:
            temporary.write(content)
        temporary_path.chmod(path.stat().st_mode)
        temporary_path.replace(path)
    finally:
        temporary_path.unlink(missing_ok=True)


def main() -> None:
    # make sure we are in the git root directory
    former_directory = Path.cwd()
    result = subprocess.run(
        ['git', 'rev-parse', '--show-toplevel'], check=True, stdout=subprocess.PIPE
    )
    os.chdir(os.fsdecode(result.stdout.removesuffix(b'\n')))
    try:
        # enforce formatting with Black
        black_command = [
            'poetry',
            'run',
            'black',
            '--check',
            '--line-length',
            '100',
            '--skip-string-normalization',
            '.',
        ]
        if subprocess.run([*black_command, '--quiet']).returncode:
            # run again to display error message(s)
            subprocess.run(black_command, check=True)
        # make sure there are no duplicate Berror codes (Bxxxxx codes to help ID points in the code)
        to_scan = git_files('ls-files', '-z', '--', '*.py', '*.dart') | git_files(
            'diff', '--name-only', '--cached', '-z'
        ) # the set of source-code files in repo plus staged, non-existant files removed
        code_counts = collections.Counter()
        for filename in sorted(to_scan):
            path = Path(filename)
            if path.is_file() and not path.is_symlink():
                code_counts.update(re.findall(rb'B[0-9]{5} ', path.read_bytes()))
        duplicate_codes = sorted(
            code.decode('ascii') for code, count in code_counts.items() if count > 1
        )
        if duplicate_codes:
            print(f"Please remove duplicate Berror code(s): {''.join(duplicate_codes)}", flush=True)
            time.sleep(2)
            raise SystemExit(1)
        # update 'versions.yaml' to track timestamp of certain files and directories
        versions_path = Path('versions.yaml')
        versions_changed = False
        watch_list = [
            'hub/bbbased.lua',
            'hub/adopt5p.sh',
            'hub/',  # any file within; must end in a slash
        ]
        if not versions_path.exists():
            versions_path.write_bytes(b'paths: []\n')
        staged_files = git_files('diff', '--cached', '--name-only', '--diff-filter=ACMR', '-z')
        commit_date = b36datetime()
        for watched_path in watch_list:
            if watched_path.endswith('/'):
                matched = any(name.startswith(watched_path) for name in staged_files)
            else:
                matched = watched_path in staged_files
            if not matched:
                continue
            original = versions_path.read_bytes()
            try:
                versions = yaml.safe_load(original)
                if versions is None:
                    versions = {}
                if not isinstance(versions, dict):
                    raise ValueError("Expected a top-level mapping.")
                paths = versions.get('paths')
                if paths is None or paths is False:
                    paths = list()
                if not isinstance(paths, list) or any(
                    entry is not None and not isinstance(entry, dict) for entry in paths
                ):
                    raise ValueError("Expected 'paths' to be a list of mappings.")
                # replacing the entire record also removes its signature and key_id, if present
                versions['paths'] = [
                    entry for entry in paths if entry is None or entry.get('path') != watched_path
                ] + [{'path': watched_path, 'version': commit_date}]
                updated = yaml.safe_dump(
                    versions, default_flow_style=False, sort_keys=False, allow_unicode=True
                ).encode('utf-8')
            except (yaml.YAMLError, ValueError) as error:
                print(
                    f"Unable to update {versions_path}; expected a top-level 'paths' list",
                    file=sys.stderr,
                )
                print(str(error), file=sys.stderr)
                raise SystemExit(1)
            if original != updated:
                replace_file(versions_path, updated)
                versions_changed = True
        if versions_changed:
            subprocess.run(['git', 'add', str(versions_path)], check=True)
        # update commit_date in 'hub/bbbased.lua'
        bbbased_path = Path('hub/bbbased.lua')
        if str(bbbased_path) in staged_files:
            # restrict whitespace to one line and preserve the original line endings.
            updated = re.sub(
                rb'^(local commit_date[^\S\n]*=[^\S\n]*)\'[^\'\n]*\'',
                lambda match: match[1] + f'\'{commit_date}\''.encode('ascii'),
                bbbased_path.read_bytes(),
                flags=re.MULTILINE,
            )
            replace_file(bbbased_path, updated)
            subprocess.run(['git', 'add', str(bbbased_path)], check=True)
    finally:
        os.chdir(former_directory)  # return to former directory


if __name__ == '__main__':
    # checked subprocess calls and file errors abort the commit with a nonzero exit status
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode if error.returncode > 0 else 128 - error.returncode)
    except (OSError, ValueError) as error:
        print(f"Pre-commit hook failed: {error}", file=sys.stderr)
        raise SystemExit(1)
